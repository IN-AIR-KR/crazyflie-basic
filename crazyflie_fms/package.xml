<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>crazyflie_fms</name>
  <version>0.0.1</version>
  <description>Crazyflie Fleet Management System — 웹 UI 기반 편대 모니터링/임무 제어</description>
  <maintainer email="gangtae9050@gmail.com">kante</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>crazyflie_interfaces</exec_depend>
  <!-- 브라우저 UI 가 ROS 에 붙는 통로. 이게 없으면 웹 UI 가 아무것도 못 한다. -->
  <exec_depend>rosbridge_server</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
